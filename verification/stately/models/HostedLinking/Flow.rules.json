{
  "guards": {},
  "actions": {},
  "context": {},
  "init": {},
  "events": {},
  "citations": {},
  "rules": [
    {
      "id": "StartsActive",
      "kind": "initially",
      "then": "in('Active')"
    },
    {
      "id": "CanComplete",
      "kind": "reachable",
      "then": "in('Completed')"
    },
    {
      "id": "CanExpireWhileCompleting",
      "kind": "reachable",
      "then": "in('Expired')"
    },
    {
      "id": "CompletingEventuallyTerminates",
      "kind": "leads-to",
      "when": "in('Completing')",
      "then": "in('Completed') || in('Expired') || in('Failed')"
    },
    {
      "id": "NoDeadEnds",
      "kind": "no-dead-ends"
    }
  ],
  "bounds": {
    "maxStates": 12000,
    "timeoutMs": 30000
  },
  "assumptions": []
}
