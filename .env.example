# Development — copy to .env; dev commands read only their selected settings.
# They own http://127.0.0.1:3000, APP_ENV=development, and the retained database.
BETTER_AUTH_SECRET=development-only-change-before-deploying-0000000000000000
OTEL_SERVICE_NAME=lineupkeep-web
SERVICE_VERSION=development
DEV_SLOW_SPAN_THRESHOLD=100 millis
# Optional mail/Google settings are below; dev reads them too. Without a Resend key,
# development prints email codes to its console. Never use this secret in production.

# Application runtime — production reference, not competing active local overrides.
# Supply required values through protected provisioning/CI inputs; see docs/deployment.md.
# BETTER_AUTH_URL=https://app.example.com
# BETTER_AUTH_SECRET=<generate-an-independent-random-secret>
# EMAIL_FROM="App <sign-in@mail.example.com>"
# RESEND_API_KEY=re_<sending-scoped-key>
# Required client-IP policy: use only headers supplied by trusted ingress.
# Cloudflare: cf-connecting-ip; Cloud Run: reviewed proxy policy.
# Header names alone do not prevent spoofing; no universal x-forwarded-for default.
# AUTH_CLIENT_IP_HEADERS=cf-connecting-ip
# Optional; only actual trusted proxy ranges for your topology, never an arbitrary CIDR.
# AUTH_TRUSTED_PROXIES=<reviewed-proxy-ranges>
# Optional provider endpoint; default is https://api.resend.com.
# RESEND_API_BASE_URL=https://api.resend.com
# Google: both or neither. Register the canonical origin and /api/auth/callback/google.
# Development callback: http://127.0.0.1:3000/api/auth/callback/google.
# GOOGLE_CLIENT_ID=<web-client-id>
# GOOGLE_CLIENT_SECRET=<web-client-secret>
# Base origin is automatically trusted. No extra-origins environment input is supported.
# Production service identity/version should come from application/release CI, not dev defaults.
# Production OTLP requires BOTH exporter selection and a deployed collector base endpoint.
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com
# Effect appends /v1/traces. Optional secret headers; URI-encode values as required.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<collector-token>
# These are the supported OTEL inputs, not a promise to forward every standard variable.

# Deployment provisioning — protected shell/CI/profile inputs, NEVER application env.
# Prefer keeping real credentials outside root .env. Select only the provider(s) needed.
# Alchemy profiles are an interactive alternative; optional ALCHEMY_PROFILE selects one.
# ALCHEMY_PROFILE=<owner-profile>
# Shared state-only Neon project; separate database and role per app, outside app stacks.
# Direct/session-capable TLS URL, never -pooler; no application-data access.
# Bootstrap, permissions, connection capacity, serialization, backup/restore: docs/deployment.md.
# ALCHEMY_STATE_DATABASE_URL=postgresql://<state-role>:<secret>@<direct-host>/alchemy_state?sslmode=verify-full
# Durable application-database provisioning only, not web runtime.
# NEON_API_KEY=<neon-provisioning-key>
# Cloudflare token path: both account ID and narrowly scoped token.
# CLOUDFLARE_ACCOUNT_ID=<32-character-hex-account-id>
# CLOUDFLARE_API_TOKEN=<worker-and-hyperdrive-token>
# Alternative global-key path (prefer scoped tokens); email alias: CLOUDFLARE_ACCOUNT_EMAIL.
# CLOUDFLARE_API_KEY=<global-api-key>
# CLOUDFLARE_EMAIL=<account-email>
# GCP option A: usable access token plus project (alias GOOGLE_CLOUD_PROJECT).
# GOOGLE_ACCESS_TOKEN=<short-lived-deployment-token>
# GOOGLE_PROJECT_ID=<deployment-project>
# GCP option B: protected service-account JSON key path, not arbitrary ADC/WIF config.
# GOOGLE_APPLICATION_CREDENTIALS=/protected/path/service-account.json
# GCP_REGION=<selected-region>
# Separately authenticate gcloud/Docker and align gcloud's active project with Alchemy.
# GCP deployment credentials are unrelated to Google sign-in credentials above.

# Generated / explicit exceptions
# Dev and remote Neon stages supply database URLs from resources; Hyperdrive is generated.
# Only explicit external-db policy/manual runtime takes user-supplied URLs:
# DATABASE_URL=postgresql://<role>:<secret>@<runtime-host>/<app-database>
# DATABASE_DIRECT_URL=postgresql://<role>:<secret>@<direct-host>/<app-database>
# APP_ENV, host ports, and platform bindings are composition-owned, not owner toggles.
# DEPLOY_TARGET is build-only (node or cloudflare); scripts/host selection supply it.
# E2E/verification ignore root .env and use synthetic configuration, never real keys.
