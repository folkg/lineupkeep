{
  "name": "@lineupkeep/backend",
  "private": true,
  "type": "module",
  "imports": {
    "#contexts/*": "./src/contexts/*",
    "#database/*": "./src/database/*",
    "#runtime/*": "./src/runtime/*",
    "#config/*": "./src/config/*",
    "#email/*": "./src/email/*",
    "#retention/*": "./src/retention/*",
    "#utilities/*": "./src/utilities/*",
    "#backend/*": "./src/*"
  },
  "exports": {
    "./scripts/*": "./scripts/*",
    "./runtime/*": "./src/runtime/*.ts",
    "./*": "./src/contexts/*.ts",
    "./email/internal/*": "./src/email/internal/*.ts"
  },
  "scripts": {
    "architecture": "node scripts/check-table-ownership.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "catalog:",
    "@better-auth/core": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/mcp": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/sql-pglite": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@lineupkeep/brand": "workspace:*",
    "@lineupkeep/lineup-solver": "workspace:*",
    "@lineupkeep/yahoo-sdk": "workspace:*",
    "@xstate/effect": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "nodemailer": "10.4.0",
    "pg": "8.23.1",
    "postgres": "catalog:",
    "xstate": "catalog:"
  }
}
