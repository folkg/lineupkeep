    "@better-auth/mcp": "1.7.12",
    "@better-auth/cimd": "1.7.12",
    "@better-auth/oauth-provider": "1.7.12",
    "@electric-sql/pglite": "0.5.11",
    "@solidjs/diagnostics": "2.0.0-rc.13",
    "@solidjs/web": "2.0.0-rc.13",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/solid-query": "6.0.0-rc.5",
    "@tanstack/solid-router": "2.0.0-rc.8",
    "@tanstack/solid-router-ssr-query": "2.0.0-rc.6",
    "@tanstack/solid-start": "2.0.0-rc.8",
    "@typeonce/effect-machine": "0.41.1",
    "@typeonce/oxlint-plugin-effect-machine": "0.41.1",
    "@vitest/browser-playwright": "5.0.5",
    "better-auth": "1.7.12",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.0.5",
    "playwright": "1.64.1",
    "postgres": "3.4.9",
    "solid-js": "2.0.0-rc.13",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "@playwright/test": "1.64.1",
    "vite": "8.3.5",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "vitest": "5.0.5",
    "nitro": "3.0.260903-beta",
    "@effect/platform-node": "4.0.5",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.83",
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.83",
    "alchemy": "2.0.0-beta.83"
  },
  "patchedDependencies": {
    "@tanstack/solid-start@2.0.0-rc.8": "patches/@tanstack%2Fsolid-start@2.0.0-rc.8.patch",
    "@better-auth/oauth-provider@1.7.12": "patches/@better-auth%2Foauth-provider@1.7.12.patch",
    "@tanstack/router-core@1.171.22": "patches/@tanstack%2Frouter-core@1.171.22.patch",
    "@tanstack/start-server-core@1.169.26": "patches/@tanstack%2Fstart-server-core@1.169.26.patch",
    "@tanstack/start-client-core@1.170.22": "patches/@tanstack%2Fstart-client-core@1.170.22.patch"
  }
}
