{
  "name": "lineupkeep",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra",
    "tools"
  ],
  "type": "module",
  "imports": {
    "#verification-programs": "./e2e/verificationPrograms.ts",
    "#e2e/*": "./e2e/*",
    "#scripts/*": "./scripts/*",
    "#repo/*": "./*"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "dev": "node infra/local/development.ts node",
    "dev:cloudflare": "node infra/local/development.ts cloudflare",
    "effect-solutions": "effect-solutions",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "knip": "knip",
    "knip:production": "knip --production",
    "format": "oxfmt",
    "format:check": "bun run format -- --check",
    "fix": "bun run format && bun run lint",
    "test": "vitest run",
    "test:node": "vitest run --project node --project tooling",
    "test:browser": "vitest run --project browser",
    "test:e2e": "node e2e/test.ts",
    "test:e2e:container": "node e2e/test.ts --target container",
    "test:e2e:cloudflare": "node e2e/test.ts --target cloudflare",
    "verify": "node e2e/verify.ts",
    "verify:video": "node e2e/verify/renderVideo.ts",
    "verify:review": "node e2e/verify/review.ts",
    "build": "bun --filter @lineupkeep/web build",
    "build:node": "DEPLOY_TARGET=node bun run build",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare bun run build",
    "build:all": "bun run build:node && bun run build:cloudflare",
    "architecture": "depcruise packages/backend/src packages/brand/src apps/web/src apps/linking-helper/src e2e infra tools scripts --output-type err-long && bun --filter @lineupkeep/backend architecture",
    "checks": "time sh -c 'bun run fix && bun run architecture && bun run knip && bun run knip:production && bun run test && bun run build:all'",
    "checks:ci": "bun run lint:check && bun run format:check && bun run architecture && bun run knip && bun run knip:production && bun run test && bun run build:all",
    "db:generate": "drizzle-kit generate --config=packages/backend/drizzle.config.ts",
    "db:migrate": "node infra/local/development.ts migrate",
    "db:start": "node infra/local/development.ts start",
    "db:stop": "node infra/local/development.ts stop",
    "db:reset": "node infra/local/development.ts reset",
    "db:studio": "node infra/local/development.ts studio",
    "update-latest": "bun update -i --recursive --latest",
    "targets:verify": "bun run build:node && bun --filter @lineupkeep/web verify:node && bun run build:cloudflare && bun --filter @lineupkeep/web verify:cloudflare"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@iconify-json/lucide": "1.2.147",
    "@lineupkeep/tools": "workspace:*",
    "@lineupkeep/web": "workspace:*",
    "@playwright/test": "catalog:",
    "@solidjs/vite-plugin": "catalog:",
    "@swc/core": "1.16.18",
    "@tanstack/start-plugin-core": "1.171.34",
    "@typeonce/oxlint-plugin-effect-machine": "catalog:",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "catalog:",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "catalog:",
    "effect-solutions": "0.5.3",
    "eslint-plugin-solid": "0.18.1",
    "knip": "6.42.1",
    "msw": "catalog:",
    "oxc-parser": "0.155.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "catalog:",
    "postgres": "catalog:",
    "typescript": "catalog:",
    "undici": "7.30.1",
    "unplugin-icons": "24.0.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@solidjs/babel-plugin": "2.0.0-rc.13",
    "@solidjs/compiler": "2.0.0-rc.13",
    "@solidjs/signals": "2.0.0-rc.13",
    "@solidjs/web": "2.0.0-rc.13",
    "solid-js": "2.0.0-rc.13"
  },
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "packageManager": "bun@1.4.3",
  "catalog": {
    "msw": "3.0.3",
    "@effect/platform-node-shared": "4.0.5",
    "@effect/sql-pg": "4.0.5",
    "@effect/sql-pglite": "4.0.5",
    "@effect/tsgo": "0.56.0",
    "@effect/vitest": "4.0.5",
    "@better-auth/drizzle-adapter": "1.7.12",
