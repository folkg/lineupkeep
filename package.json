{
  "name": "lineupkeep",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra",
    "tools"
  ],
  "type": "module",
  "imports": {
    "#verification-programs": "./e2e/verificationPrograms.ts",
    "#e2e/*": "./e2e/*",
    "#repo/*": "./*"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "dev": "node infra/local/development.ts node",
    "dev:cloudflare": "node infra/local/development.ts cloudflare",
    "effect-solutions": "effect-solutions",
    "lint": "effect-tsgo --tsrs-lint oxlint --fix",
    "lint:check": "effect-tsgo --tsrs-lint oxlint",
    "knip": "knip",
    "knip:production": "knip --production",
    "format": "oxfmt",
    "format:check": "bun run format -- --check",
    "fix": "bun run format && bun run lint",
    "test": "bun run test:node && bun run test:browser && bun run test:chromium",
    "test:node": "vitest run --project node",
    "test:node:main": "VITEST_NODE_MAIN=1 vitest run --project node",
    "test:node:fixtures": "vitest run --project node scripts/dependencyCruiser.test.ts scripts/oxlint.test.ts",
    "test:browser": "vitest run --project browser",
    "test:chromium": "vitest run --project chromium",
    "test:e2e": "node e2e/test.ts",
    "test:e2e:container": "node e2e/test.ts --target container",
    "test:e2e:cloudflare": "node e2e/test.ts --target cloudflare",
    "mcp:accept": "node scripts/mcpAccept.ts",
    "verify": "node e2e/verify.ts",
    "verify:video": "node e2e/verify/renderVideo.ts",
    "verify:review": "node e2e/verify/review.ts",
    "build": "bun --filter @lineupkeep/web build",
    "build:node": "DEPLOY_TARGET=node bun run build",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare bun run build",
    "build:all": "bun run build:node && bun run build:cloudflare",
    "architecture": "depcruise packages/backend/src packages/brand/src packages/hosted-browser/src packages/lineup-solver/src packages/machine-test/src packages/yahoo-sdk/src apps/web/src apps/hosted-browser/src e2e infra tools scripts --output-type err-long && bun --filter @lineupkeep/backend architecture",
    "checks": "time sh -c 'bun run fix && bun run architecture && bun run knip && bun run knip:production && bun run test && bun run build:all'",
    "checks:ci": "bun run lint:check && bun run format:check && bun run architecture && bun run knip && bun run knip:production && bun run test && bun run build:all",
    "checks:ci:main": "bun run lint:check && bun run format:check && bun run architecture && bun run knip && bun run knip:production && bun run test:node:main && bun run test:browser && bun run test:chromium && bun run build:all",
    "checks:ci:fixtures": "bun run test:node:fixtures",
    "db:generate": "drizzle-kit generate --config=packages/backend/drizzle.config.ts",
    "db:migrate": "node infra/local/development.ts migrate",
    "db:start": "node infra/local/development.ts start",
    "db:stop": "node infra/local/development.ts stop",
    "db:reset": "node infra/local/development.ts reset",
    "db:studio": "node infra/local/development.ts studio",
    "update-latest": "bun update -i --recursive --latest",
    "targets:verify": "bun run build:node && bun --filter @lineupkeep/web verify:node && bun run build:cloudflare && bun --filter @lineupkeep/web verify:cloudflare"
  },
  "dependencies": {
    "@lineupkeep/collections": "workspace:*",
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@iconify-json/lucide": "1.2.158",
    "@lineupkeep/tools": "workspace:*",
    "@lineupkeep/web": "workspace:*",
    "@playwright/test": "catalog:",
    "@solidjs/vite-plugin": "catalog:",
    "@swc/core": "1.16.22",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/start-plugin-core": "1.172.0",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "catalog:",
    "dependency-cruiser": "18.8.0",
    "drizzle-kit": "catalog:",
    "effect-solutions": "0.5.3",
    "eslint-plugin-solid": "0.20.1",
    "knip": "6.47.0",
    "msw": "catalog:",
    "oxc-parser": "0.159.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "playwright": "catalog:",
    "postgres": "catalog:",
    "typescript": "catalog:",
    "undici": "7.30.2",
    "unplugin-icons": "24.0.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@solidjs/babel-plugin": "2.0.2",
    "@solidjs/compiler": "2.0.2",
    "@solidjs/signals": "2.0.3",
    "@solidjs/web": "2.0.3",
    "@tanstack/query-core": "5.107.1",
    "@tanstack/solid-query": "6.0.0-rc.6",
    "seroval": "1.6.12",
    "seroval-plugins": "1.6.12",
    "solid-js": "2.0.3",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "packageManager": "bun@1.4.3",
  "catalog": {
    "msw": "3.0.7",
    "h3": "2.0.8",
    "@effect/platform-node-shared": "4.1.5",
    "@effect/sql-pg": "4.1.5",
    "@effect/sql-pglite": "4.1.5",
    "@effect/tsgo": "0.73.2",
    "@effect/vitest": "4.1.5",
    "@better-auth/drizzle-adapter": "1.7.27",
    "@better-auth/core": "1.7.27",
    "@better-auth/mcp": "1.7.27",
    "@better-auth/cimd": "1.7.27",
    "@better-auth/oauth-provider": "1.7.27",
    "@electric-sql/pglite": "0.5.17",
    "@solidjs/diagnostics": "2.0.3",
    "@solidjs/web": "2.0.3",
    "@tailwindcss/vite": "4.3.5",
    "@xstate/effect": "1.0.0-beta.3",
    "@tanstack/solid-query": "6.0.0-rc.6",
    "@tanstack/solid-router": "2.0.0-rc.11",
    "@tanstack/solid-router-ssr-query": "2.0.0-rc.9",
    "@tanstack/solid-start": "2.0.0-rc.11",
    "@vitest/browser-playwright": "5.1.1",
    "better-auth": "1.7.27",
    "drizzle-kit": "1.0.0-rc.6",
    "drizzle-orm": "1.0.0-rc.6",
    "effect": "4.1.5",
    "playwright": "1.65.1",
    "postgres": "4.1.1",
    "solid-js": "2.0.3",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "@playwright/test": "1.65.1",
    "vite": "8.3.8",
    "@solidjs/vite-plugin": "3.0.1",
    "vitest": "5.1.1",
    "xstate": "6.0.0-beta.4",
    "nitro": "3.0.261103-rc",
    "@effect/platform-node": "4.1.5",
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/docker": "2.0.0-beta.87",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.87",
    "@alchemy.run/gcp": "2.0.0-beta.87",
    "@alchemy.run/neon": "2.0.0-beta.87",
    "@alchemy.run/sql": "2.0.0-beta.87",
    "@alchemy.run/test": "2.0.0-beta.87",
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.87",
    "alchemy": "2.0.0-beta.87",
    "ws": "8.23.0",
    "@types/ws": "8.18.2"
  },
  "patchedDependencies": {
    "@tanstack/start-server-core@1.169.45": "patches/@tanstack%2Fstart-server-core@1.169.45.patch",
    "@better-auth/cimd@1.7.27": "patches/@better-auth%2Fcimd@1.7.27.patch"
  }
}
