  "narrative": {
    "northStar": "The Considered Instrument",
    "overview": "An assured fantasy-team instrument with sporting energy: royal violet actions, golden yellow accents, and deep violet ink. A continuous lowercase wordmark, one self-hosted family, and ruled information keep the identity professional and solid.\n\nThis is an Operate product: familiar navigation, native controls, direct labels, and information before spectacle. Light supports daytime checks and dark supports evening use. The brand foundation is implemented; the fantasy product is not.",
    "keyCharacteristics": [
      "Continuous typographic identity",
      "Clear operational state",
      "Confident sporting colour",
      "Light and dark as complete palettes"
    ],
    "rules": [
      {
        "name": "The Violet and Gold Rule",
        "body": "Violet owns everyday interaction; gold brings focused energy to highlighted actions and labelled attention. Do not use either colour alone as a success, warning, or risk signal.",
        "section": "colors"
      },
      {
        "name": "The Continuous Word Rule",
        "body": "Use Lineupkeep in prose and lineupkeep in the wordmark. The shared up is discoverable; no gap, uppercase UP, colour alternation, or extra logo badge.",
        "section": "typography"
      },
      {
        "name": "The Honest Surface Rule",
        "body": "A surface exists to group a task or establish hierarchy, not to make sparse content look substantial.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic tokens and both complete themes.",
      "Do keep the wordmark continuous and uniform.",
      "Do distinguish verified, pending, and uncertain outcomes.",
      "Do label sample data and retained starter scaffolding honestly.",
      "Do preserve keyboard access, visible focus, and reduced motion."
    ],
    "donts": [
      "Don't use LineUPkeep, LineUpKeep, arrows, trophies, shields, or AI decoration.",
      "Don't use gradient lettering, lime stickers, tilted paper, or simulated notebooks.",
      "Don't infer the fantasy domain by renaming the Notes demo.",
      "Don't use colour alone to communicate connection, automation, or risk.",
      "Don't claim live features, ownership, accuracy, or publication readiness without evidence."
    ]
  }
