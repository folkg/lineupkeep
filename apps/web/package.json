{
  "name": "@lineupkeep/web",
  "private": true,
  "type": "module",
  "imports": {
    "#browser/*": "./src/browser/*",
    "#server/*": "./src/server/*",
    "#server-functions/*": "./src/server-functions/*",
    "#contracts/*": "./src/contracts/*",
    "#routes/*": "./src/routes/*",
    "#theme/*": "./src/theme/*",
    "#web/*": "./src/*",
    "#deploy/*": "./deploy/*",
    "#deployment-target": "./src/server/targets/node.ts",
    "#verification-route": "./src/server/verificationDisabled.ts",
    "#backend-runtime": "@lineupkeep/backend/runtime/BackendRuntime"
  },
  "exports": {
    "./deploy/*": "./deploy/*",
    "./server/*": "./src/server/*"
  },
  "scripts": {
    "build": "vite build",
    "verify:node": "node deploy/node/verify.ts",
    "verify:cloudflare": "node deploy/cloudflare/verify.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "catalog:",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@kobalte/core": "2.0.0-alpha.2",
    "@lineupkeep/backend": "workspace:*",
    "@lineupkeep/brand": "workspace:*",
    "@lineupkeep/hosted-browser": "workspace:*",
    "@solidjs/vite-plugin": "catalog:",
    "@solidjs/web": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/solid-query": "catalog:",
    "@tanstack/solid-router": "catalog:",
    "@tanstack/solid-router-ssr-query": "catalog:",
    "@tanstack/solid-start": "catalog:",
    "better-auth": "catalog:",
    "effect": "catalog:",
    "h3": "catalog:",
    "solid-js": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "ws": "catalog:",
    "xstate": "6.0.0-alpha.70"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare-runtime": "catalog:",
    "@solidjs/diagnostics": "catalog:",
    "@types/ws": "catalog:",
    "crossws": "0.4.15",
    "fast-check": "4.10.2",
    "nitro": "catalog:"
  }
}
